{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/themonagroup/mona-thoi-khoa-bieu/schema/input.schema.json",
  "title": "MONA Thời Khóa Biểu — input v0.1.0",
  "description": "Các mã phải duy nhất trong từng nhóm. Tham chiếu lớp/môn/GV, tính liên tiếp của session, lịch bận và khả thi được kiểm tra thêm bởi engine.",
  "type": "object",
  "required": ["classes", "teachers", "subjects", "assignments"],
  "additionalProperties": false,
  "properties": {
    "calendar": { "$ref": "#/$defs/calendar" },
    "classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/class" } },
    "teachers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/teacher" } },
    "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subject" } },
    "assignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assignment" } },
    "fixed": { "type": "array", "items": { "$ref": "#/$defs/fixed" }, "default": [] }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "day": { "type": "integer", "minimum": 2, "maximum": 8, "description": "2 = thứ Hai; 8 = Chủ nhật" },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["day", "period"],
      "properties": { "day": { "$ref": "#/$defs/day" }, "period": { "$ref": "#/$defs/integer" } }
    },
    "slots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slot" } },
    "calendar": {
      "type": "object", "additionalProperties": false, "required": ["days", "periods"],
      "description": "Mặc định thứ 2–7, 5 tiết sáng. Thứ tự periods xác định tiết liên tiếp; cùng session phải nằm cạnh nhau.",
      "properties": {
        "days": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/day" } },
        "periods": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "session"],
            "properties": { "id": { "$ref": "#/$defs/integer" }, "label": { "$ref": "#/$defs/id" }, "session": { "$ref": "#/$defs/id" } }
          }
        }
      }
    },
    "class": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" },
        "available": { "$ref": "#/$defs/slots", "description": "Bỏ trống thuộc tính: dùng toàn bộ lịch; mảng rỗng: không được học ở ô nào." }
      }
    },
    "teacher": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" }, "unavailable": { "$ref": "#/$defs/slots", "default": [] } }
    },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/id" },
        "double": { "type": "boolean", "default": false },
        "heavy": { "type": "boolean", "default": false },
        "maxPerDay": { "$ref": "#/$defs/integer", "default": 2 }
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false,
      "required": ["classId", "subjectId", "teacherId", "periods"],
      "properties": { "classId": { "$ref": "#/$defs/id" }, "subjectId": { "$ref": "#/$defs/id" }, "teacherId": { "$ref": "#/$defs/id" }, "periods": { "$ref": "#/$defs/integer" } }
    },
    "fixed": {
      "type": "object", "additionalProperties": false,
      "required": ["classId", "subjectId", "teacherId", "day", "period"],
      "description": "Tiết cố định nằm trong tổng periods của phân công, không cộng thêm tiết.",
      "properties": { "classId": { "$ref": "#/$defs/id" }, "subjectId": { "$ref": "#/$defs/id" }, "teacherId": { "$ref": "#/$defs/id" }, "day": { "$ref": "#/$defs/day" }, "period": { "$ref": "#/$defs/integer" } }
    }
  }
}
